pkgname=linux-imagetools-headless
provides=(linux-imagetools)
pkgver=1
pkgrel=1
pkgdesc="Useful combination of tools for processing various images"
arch=('any')
license=('GPL')
source=(
#  imagetools_01_exif_statistics.sh
  imagetools_02_cr2todng_batch_headless.sh
  imagetools_03_raw_resolution-baseline_canon_5dmk3_batch_headless.sh
  imagetools_04_mlvdump_batch_headless.sh
#  imagetools_05_mlvinfo_desktop.sh
  imagetools_06_exif_deletedata_batch.sh
  imagetools_06_exif_deletedata_critical_batch.sh
  imagetools_07_ale_stack.sh
  imagetools_09_repair_image_mtime_batch.sh
)

depends=(
  magiclantern-tools
  perl-image-exiftool
  ale
  dcraw
  netpbm
  coreutils
  dnglab
)

md5sums=('7b610cd51c0b06f8d1fd4be80e82769d'
         '6da7f619d03aff2399e7d007971b99ff'
         '22b1ac78265146394bc74edf4a5c23a0'
         'ca6959488844c656803836159dd2a1d2'
         '628ca4befa6bc65de067bbfce599ea98'
         '3b4f541df70a95292625edf28ed6f349'
         '3ee231f6da77907e20190d2f14cae907')

package() {
  mkdir -p "${pkgdir}/usr/bin/"
  for i in "${srcdir}/"*.sh
  do
    chmod 0755 "${i}"
    cp -p "${i}" "${pkgdir}/usr/bin/$(basename -s .sh ${i} | sed 's/imagetools_[0-9]*_//; s/_headless$//')"
  done
}
